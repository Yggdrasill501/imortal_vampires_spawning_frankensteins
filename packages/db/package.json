{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "kysely migrate:latest",
    "migrate:down": "kysely migrate:down",
    "migrate:make": "kysely migrate:make",
    "codegen": "kysely-codegen --dialect postgres --env-file ../../.env --out-file src/schema.ts"
  },
  "dependencies": {
    "kysely": "^0.29.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "typescript": "catalog:"
  }
}