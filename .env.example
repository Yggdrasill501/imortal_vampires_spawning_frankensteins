# Matches the Postgres service in docker-compose.yml (host port 5434).
DATABASE_URL=postgres://postgres:postgres@localhost:5434/imortal_vampires_spawning_frankenstains

# Apify API token (Console -> Settings -> API & Integrations). Used by scripts/test-apify-openrouter.mjs.
APIFY_TOKEN=
ELEVENLABS_TOKEN=

# Stretch goal (Slack and Linear pickup).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_DEFAULT_CHANNEL=
LINEAR_API_KEY=
LINEAR_TEAM_KEY=
CURSOR_API_KEY=

# OrangeHRM (system A): private on-demand instance.
ORANGEHRM_URL=
ORANGEHRM_USERNAME=
ORANGEHRM_PASSWORD=

# Test emails (scripts/send-test-emails.mjs). TEST_MAIL_PASS is a Gmail app password, not the account password.
TEST_MAIL_USER=
TEST_MAIL_PASS=
TEST_MAIL_TO=

# Lab service (apps/lab). All optional except DATABASE_URL above.
LAB_PORT=4000
LAB_HOST=localhost
LAB_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LAB_SHELF_DIR=shelf
LAB_DATA_DIR=.lab
LAB_MODEL=auto
LAB_MAX_MONSTERS=3
LAB_MAX_RUNS=2
LAB_AGENT_USE_API_KEY=0
# Systems the orchestrator may propose, a JSON array; "site" is a host name for a website or a name for a connector. Example: [{"name":"HR system","site":"hr.example.com","kind":"website","loginNeeded":true},{"name":"Mailbox","site":"gmail","kind":"connector","loginNeeded":false}]
# A system may add "loginFrom":"PREFIX": its login is then read from PREFIX_USERNAME and PREFIX_PASSWORD, and the invitation form does not ask for it.
LAB_KNOWN_SYSTEMS=
# Read-only mailbox for the gmail connector. LAB_MAIL_PASS is a Gmail app password (two-step verification on), not the account password.
LAB_MAIL_USER=
LAB_MAIL_PASS=
LAB_MAIL_HOST=imap.gmail.com
LAB_MAIL_PORT=993

# Web app (apps/web). All optional; the app runs with none of them set.
# Address of the lab service. Default: http://localhost:4000
NEXT_PUBLIC_LAB_URL=
# Simulated data: on when unset or 1, off when 0 (then the app calls the lab service).
NEXT_PUBLIC_LAB_MOCK=
# Public id of the ElevenLabs agent for the voice interview. Unset: voice is off, typing still works.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
